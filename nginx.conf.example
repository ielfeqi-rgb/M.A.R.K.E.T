# =====================================================================
# Nginx Reverse Proxy Configuration for M.A.R.K.E.T AI
# Place in: /etc/nginx/sites-available/market-ai.conf
# Symlink to: /etc/nginx/sites-enabled/
# =====================================================================

server {
    listen 80;
    server_name your-domain.com www.your-domain.com;

    # Redirect all HTTP traffic to HTTPS (recommended once SSL is active)
    # return 301 https://$host$request_uri;

    # Core Application Proxy (FastAPI & Dashboard)
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        # WebSocket & Long-Polling headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Real Client IP and Host headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts for streaming AI responses
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
        proxy_send_timeout 300s;
        client_max_body_size 50M;
    }

    # WhatsApp Gateway Proxy (Optional, if exposing directly or via webhook)
    location /wa/ {
        proxy_pass http://127.0.0.1:2785/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
