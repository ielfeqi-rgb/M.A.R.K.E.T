# OmniContext AI 2.0 - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# APPLICATION SETTINGS
# ============================================
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# Server
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# FACEBOOK MESSENGER
# ============================================
# Get from: Facebook Developers > Messenger > Settings > Access Tokens
FB_PAGE_TOKEN=your_page_access_token_here
# Any string you choose for webhook verification
FB_VERIFY_TOKEN=change_me_in_production_secure_token
# Optional: For verifying webhook signatures
FB_APP_SECRET=

# ============================================
# OLLAMA (Local LLM)
# ============================================
# Use http://host.docker.internal:11434 if running in Docker
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=30
OLLAMA_MAX_RETRIES=3

# ============================================
# EXCEL PRODUCT DATABASE
# ============================================
EXCEL_PATH=products.xlsx
EXCEL_RELOAD_INTERVAL=300

# ============================================
# NGROK (For webhook tunneling)
# ============================================
# Get from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional: Reserve a domain on ngrok dashboard
NGROK_DOMAIN=

# ============================================
# CONVERSATION HISTORY
# ============================================
HISTORY_MAX_MESSAGES=10
HISTORY_TTL_SECONDS=3600

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60