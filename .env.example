# =====================================================================
# M.A.R.K.E.T AI - Production Environment Configuration (.env)
# =====================================================================

# Server Settings
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
APP_VERSION=3.5.0

# AI Provider Settings (gemini / groq / ollama / openai / deepseek / custom)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional Cloud Providers
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Local Models (Ollama / Llama.cpp)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
CODER_MODEL=qwen2.5-coder:0.5b
CUSTOM_AI_URL=http://localhost:8081/v1
CUSTOM_AI_MODEL=qwen2.5-1.5b.gguf

# Excel Product Database
EXCEL_PATH=products.xlsx

# Facebook & Messenger Webhooks
FB_PAGE_TOKEN=
FB_VERIFY_TOKEN=your_secure_verify_token_here
FB_APP_SECRET=
AUTO_REPLY_COMMENTS=true
COMMENT_REPLY_MODE=both

# WhatsApp OpenWA Gateway
WHATSAPP_ENABLED=true
WHATSAPP_OPENWA_URL=http://localhost:2785
WHATSAPP_OPENWA_API_KEY=
WHATSAPP_SESSION_ID=market-bot
WHATSAPP_AUTO_REPLY=true
WHATSAPP_SEND_PURCHASE_CONFIRMATION=true

# IT Alerting & Notification Bot (Telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public Tunneling (Optional for local testing)
NGROK_AUTHTOKEN=